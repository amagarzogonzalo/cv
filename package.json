{
  "name": "cv",
  "version": "1.0.0",
  "private": true,
  "description": "Personal CV / resume website — Astro + Tailwind CSS, deployed on Cloudflare Pages.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "vite": "^7.3.7"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^6.4.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.1"
  }
}
