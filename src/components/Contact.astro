---
import { cv } from '../data/cv';
import Icon from './Icon.astro';

const { personal, links } = cv;
---

<section
  id="contact"
  class="mx-auto max-w-4xl scroll-mt-20 px-5 py-12"
  aria-labelledby="contact-heading"
>
  <div class="card rounded-3xl border border-border bg-bg-subtle p-8 sm:p-10">
    <h2 id="contact-heading" class="text-2xl font-bold tracking-tight">Get in touch</h2>
    <p class="mt-3 max-w-xl text-fg-muted">
      {personal.availability ?? 'Always happy to talk'} — the fastest way to reach me is email.
    </p>

    <div class="no-print mt-6 flex flex-wrap gap-3">
      <a
        href={`mailto:${personal.email}`}
        class="inline-flex items-center gap-2 rounded-xl bg-brand px-4 py-2.5 text-sm font-semibold text-brand-fg shadow-sm transition hover:opacity-90"
      >
        <Icon name="email" class="size-4" />
        {personal.email}
      </a>

      {
        links
          .filter((link) => link.icon !== 'email')
          .map((link) => (
            <a
              href={link.url}
              target={link.url.startsWith('http') ? '_blank' : undefined}
              rel={link.url.startsWith('http') ? 'me noopener noreferrer' : undefined}
              class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface px-4 py-2.5 text-sm font-semibold text-fg transition hover:bg-bg-subtle"
            >
              <Icon name={link.icon} class="size-4" />
              {link.label}
            </a>
          ))
      }
    </div>
  </div>
</section>
