---
import { cv } from '../data/cv';
import Icon from './Icon.astro';

const projects = cv.projects;
const count = projects.length;
const pad = (n: number) => String(n).padStart(2, '0');

/** Per-project accent, used for the media glow and index badge. */
const ACCENTS = ['#6366f1', '#06b6d4', '#8b5cf6', '#10b981', '#f59e0b', '#f43f5e', '#ec4899'];
---

<div
  class="proj-carousel relative overflow-hidden rounded-2xl border border-border bg-surface"
  data-showcase
  role="group"
  aria-roledescription="carousel"
  aria-label="Selected projects"
>
  <div
    class="proj-track flex snap-x snap-mandatory overflow-x-auto"
    data-track
    tabindex="0"
    aria-label="Project slides. Use the left and right arrow keys to move between projects."
  >
    {
      projects.map((project, i) => (
        <article
          class="proj-slide relative grid w-full shrink-0 snap-start lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)]"
          data-slide
          role="group"
          aria-roledescription="slide"
          aria-label={`${project.name} — project ${i + 1} of ${count}`}
          style={`--proj-accent: ${ACCENTS[i % ACCENTS.length]}`}
        >
          <span
            class="absolute inset-x-0 top-0 z-20 h-[3px]"
            style="background: linear-gradient(90deg, color-mix(in srgb, var(--proj-accent, var(--brand)) 85%, transparent), transparent);"
            aria-hidden="true"
          />
          <div class="h-full p-3 lg:p-4">
            <div
              class:list={[
                'proj-media relative h-full w-full overflow-hidden rounded-2xl lg:aspect-auto lg:min-h-[24rem]',
                project.video ? 'aspect-video bg-black' : 'aspect-[16/10] bg-bg-subtle',
              ]}
            >
              {project.video ? (
                <video
                  class="absolute inset-0 size-full bg-black object-contain"
                  src={project.video}
                  poster={project.image}
                  muted
                  loop
                  playsinline
                  controls
                  preload="metadata"
                  aria-label={`${project.name} demo`}
                />
              ) : project.logo ? (
                <div class="absolute inset-0 flex items-center justify-center bg-white p-8 sm:p-12">
                  <img
                    src={project.logo}
                    alt={`${project.name} logo`}
                    class="max-h-[45%] w-auto max-w-[72%] object-contain"
                  />
                </div>
              ) : (
                <img
                  src={project.image ?? `/projects/${project.slug}.webp`}
                  alt=""
                  width="1200"
                  height="800"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="absolute inset-0 size-full object-cover"
                />
              )}
              <span class="proj-grid-overlay" aria-hidden="true" />
              <span class="proj-glow" aria-hidden="true" />
              <span class="proj-shine" aria-hidden="true" />
              <span
                class="absolute top-5 left-5 rounded-lg border px-2 py-1 font-mono text-[11px] tabular-nums text-white/90 backdrop-blur-sm"
                style="background: color-mix(in srgb, var(--proj-accent, var(--brand)) 34%, rgb(0 0 0 / 0.4)); border-color: color-mix(in srgb, var(--proj-accent, var(--brand)) 60%, transparent);"
              >
                {pad(i + 1)} / {pad(count)}
              </span>
            </div>
          </div>

          <div class="proj-body flex flex-col gap-5 p-6 sm:p-8">
            <div>
              <h3
                id={`proj-${project.slug}-title`}
                class="text-xl font-bold tracking-tight sm:text-2xl"
              >
                {project.name}
              </h3>
              <div class="mt-2 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center rounded-full bg-brand-soft px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-brand">
                  {project.role}
                </span>
                <span class="font-mono text-[10px] uppercase tracking-wider text-fg-subtle">
                  {project.year}
                </span>
              </div>
              <p class="mt-2 text-sm text-fg-muted">{project.tagline}</p>
            </div>

            <ul class="space-y-2.5">
              {project.highlights.map((highlight, hi) => {
                const isImpact = hi === project.highlights.length - 1;
                return (
                  <li
                    class:list={[
                      'text-sm leading-relaxed',
                      isImpact ? 'font-medium text-brand' : 'text-fg-muted',
                    ]}
                  >
                    {highlight}
                  </li>
                );
              })}
            </ul>

            <div class="flex flex-wrap items-center gap-2">
              {project.metric && (
                <p class="inline-flex items-center gap-2 rounded-full bg-brand-soft px-3 py-1 text-xs font-semibold text-brand">
                  <span class="tabular-nums">{project.metric.value}</span>
                  <span class="font-normal opacity-80">{project.metric.label}</span>
                </p>
              )}
              <ul class="flex flex-wrap gap-1.5" aria-label="Technologies">
                {project.stack.map((tech) => (
                  <li class="rounded border border-border px-2 py-0.5 font-mono text-[11px] text-fg-muted">
                    {tech}
                  </li>
                ))}
              </ul>
            </div>

            {(project.repo || project.url) && (
              <div class="mt-auto flex flex-wrap gap-2 pt-1">
                {project.repo && (
                  <a
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-xs font-medium text-fg-muted transition hover:bg-bg-subtle hover:text-fg"
                  >
                    <Icon name="github" class="size-3.5" />
                    Source
                  </a>
                )}
                {project.url && (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-xs font-medium text-fg-muted transition hover:bg-bg-subtle hover:text-fg"
                  >
                    <Icon name="external" class="size-3.5" />
                    Project site
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <div class="proj-controls flex items-center gap-3 border-t border-border px-4 py-3 sm:px-5">
    <div class="flex shrink-0 items-center gap-1.5">
      <button
        type="button"
        data-prev
        aria-label="Previous project"
        class="grid size-8 place-items-center rounded-lg border border-border text-fg-muted transition hover:bg-bg-subtle hover:text-fg disabled:cursor-not-allowed disabled:opacity-35"
      >
        <Icon name="chevron-left" class="size-4" />
      </button>
      <button
        type="button"
        data-next
        aria-label="Next project"
        class="grid size-8 place-items-center rounded-lg border border-border text-fg-muted transition hover:bg-bg-subtle hover:text-fg disabled:cursor-not-allowed disabled:opacity-35"
      >
        <Icon name="chevron-right" class="size-4" />
      </button>
    </div>

    <ol
      class="flex min-w-0 flex-1 items-center gap-0.5 overflow-x-auto"
      aria-label="Choose a project"
    >
      {
        projects.map((project, i) => (
          <li class="shrink-0">
            <button
              type="button"
              data-dot
              aria-current={i === 0 ? 'true' : 'false'}
              aria-label={`Show ${project.name}`}
              class="rail flex items-center gap-2 rounded-lg px-2.5 py-1.5 font-mono text-xs text-fg-subtle transition hover:bg-bg-subtle hover:text-fg"
            >
              <span class="tabular-nums">{pad(i + 1)}</span>
              <span class="hidden lg:inline">{project.shortName}</span>
            </button>
          </li>
        ))
      }
    </ol>

    <p
      class="hidden shrink-0 font-mono text-xs tabular-nums text-fg-subtle sm:block"
      data-count
      aria-hidden="true"
    >
      {pad(1)} / {pad(count)}
    </p>
    <p class="sr-only" data-status aria-live="polite"></p>
  </div>
</div>

<style>
  .proj-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .proj-track::-webkit-scrollbar {
    display: none;
  }

  .rail[aria-current='true'] {
    color: var(--brand);
    background-color: var(--brand-soft);
  }

  /* Card treatment: tinted glow orb, blueprint grid, hover lift and shine. */
  .proj-carousel {
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .proj-carousel:hover {
    border-color: color-mix(in srgb, var(--brand) 42%, var(--border));
    box-shadow:
      0 18px 50px rgb(0 0 0 / 0.08),
      0 0 44px color-mix(in srgb, var(--brand) 16%, transparent);
  }

  .proj-media {
    isolation: isolate;
  }

  .proj-glow {
    position: absolute;
    top: -8rem;
    right: -8rem;
    z-index: 1;
    width: 22rem;
    height: 22rem;
    border-radius: 9999px;
    pointer-events: none;
    filter: blur(42px);
    opacity: 0.3;
    background: color-mix(in srgb, var(--proj-accent, var(--brand)) 60%, transparent);
    transition:
      transform 0.45s ease,
      opacity 0.3s ease;
  }

  .proj-carousel:hover .proj-glow {
    opacity: 0.55;
    transform: scale(1.15);
  }

  .proj-grid-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.07) 1px, transparent 1px);
    background-size: 38px 38px;
    -webkit-mask-image: linear-gradient(145deg, #000 0%, transparent 78%);
    mask-image: linear-gradient(145deg, #000 0%, transparent 78%);
  }

  .proj-shine {
    position: absolute;
    top: -40%;
    left: -25%;
    z-index: 2;
    width: 12%;
    height: 190%;
    pointer-events: none;
    opacity: 0;
    transform: rotate(19deg);
    background: linear-gradient(
      90deg,
      transparent,
      rgb(255 255 255 / 0.1),
      rgb(255 255 255 / 0.18),
      transparent
    );
  }

  .proj-carousel:hover .proj-shine {
    animation: proj-shine 1.1s ease-in-out;
  }

  :global(.dark) .proj-glow {
    opacity: 0.42;
  }

  @keyframes proj-shine {
    0% {
      left: -25%;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    100% {
      left: 115%;
      opacity: 0;
    }
  }

  ol {
    scrollbar-width: none;
  }

  ol::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;

    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-slide]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const status = root.querySelector<HTMLElement>('[data-status]');
    const count = root.querySelector<HTMLElement>('[data-count]');

    if (slides.length === 0) return;

    let index = 0;
    const pad = (n: number) => String(n).padStart(2, '0');

    const render = () => {
      if (prev) prev.disabled = index <= 0;
      if (next) next.disabled = index >= slides.length - 1;
      dots.forEach((dot, i) => {
        dot.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
      if (count) count.textContent = `${pad(index + 1)} / ${pad(slides.length)}`;
      if (status) status.textContent = `Project ${index + 1} of ${slides.length} shown.`;
    };

    const goTo = (i: number) => {
      index = Math.max(0, Math.min(slides.length - 1, i));
      const left = slides[index].offsetLeft - slides[0].offsetLeft;
      track.scrollTo({ left, behavior: prefersReducedMotion() ? 'auto' : 'smooth' });
      const activeDot = dots[index];
      if (activeDot) {
        activeDot.scrollIntoView({ inline: 'nearest', block: 'nearest' });
      }
      render();
    };

    prev?.addEventListener('click', () => goTo(index - 1));
    next?.addEventListener('click', () => goTo(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(index + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(index - 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        goTo(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        goTo(slides.length - 1);
      }
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const i = slides.indexOf(entry.target as HTMLElement);
            if (i !== -1 && i !== index) {
              index = i;
              render();
            }
          });
        },
        { root: track, threshold: 0.55 },
      );
      slides.forEach((slide) => observer.observe(slide));
    }

    render();
  });
</script>
