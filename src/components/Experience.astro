---
import { cv } from '../data/cv';
import { formatRange, isoDate, duration } from '../lib/format';
import Icon from './Icon.astro';
import Section from './Section.astro';

const { experience } = cv;
---

<Section id="experience" number="02" title="Experience" meta={`${experience.length} roles`}>
  <ol class="divide-y divide-border">
    {
      experience.map((job) => {
        const span = duration(job.start, job.end);
        return (
          <li class="grid gap-3 py-7 first:pt-0 last:pb-0 sm:grid-cols-[9.5rem_1fr] sm:gap-8">
            <div class="font-mono text-xs leading-relaxed text-fg-subtle">
              <time datetime={isoDate(job.start)} class="block tabular-nums">
                {formatRange(job.start, job.end)}
              </time>
              {span && <span class="block text-fg-subtle/70">{span}</span>}
              <span class="mt-1 block">{job.location}</span>
            </div>

            <div>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="text-base font-semibold tracking-tight text-fg">{job.role}</h3>
                <span class="rounded bg-brand-soft px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-brand">
                  {job.domain}
                </span>
              </div>

              <p class="mt-1 text-sm font-medium text-brand">
                {job.url ? (
                  <a
                    href={job.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 hover:underline"
                  >
                    {job.company}
                    <Icon name="arrow-up-right" class="size-3.5" />
                  </a>
                ) : (
                  job.company
                )}
              </p>

              <p class="mt-2 text-sm text-fg-muted">{job.summary}</p>

              <ul class="mt-3 list-disc space-y-1.5 pl-4 text-sm text-fg-muted marker:text-fg-subtle">
                {job.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>

              <ul
                class="mt-3 flex flex-wrap gap-1.5"
                aria-label={`Technologies used at ${job.company}`}
              >
                {job.stack.map((tech) => (
                  <li class="rounded border border-border px-2 py-0.5 font-mono text-[11px] text-fg-muted">
                    {tech}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ol>
</Section>
