---
import { cv } from '../data/cv';
import { formatRange, isoDate, duration } from '../lib/format';
import Icon from './Icon.astro';

const { experience } = cv;
---

<section
  id="experience"
  class="mx-auto max-w-4xl scroll-mt-20 px-5 py-10"
  aria-labelledby="experience-heading"
>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <h2 id="experience-heading" class="text-2xl font-bold tracking-tight">Experience</h2>
    <p class="text-sm text-fg-subtle">
      <span class="tabular-nums">{String(experience.length).padStart(2, '0')}</span> roles · most recent
      first
    </p>
  </div>

  <ol class="mt-8 space-y-8 border-l border-border">
    {
      experience.map((job) => {
        const span = duration(job.start, job.end);
        return (
          <li class="relative pl-6 sm:pl-8">
            <span
              class="absolute -left-[6.5px] top-2.5 size-3 rounded-full border-2 border-bg bg-brand ring-1 ring-brand/30"
              aria-hidden="true"
            />

            <div class="card rounded-2xl border border-border bg-surface p-5 sm:p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="text-lg font-semibold tracking-tight text-fg">{job.role}</h3>
                <p class="flex items-center gap-2 text-sm text-fg-subtle">
                  <Icon name="calendar" class="size-4" />
                  <time datetime={isoDate(job.start)}>{formatRange(job.start, job.end)}</time>
                  {span && <span class="text-fg-subtle/70">· {span}</span>}
                </p>
              </div>

              <p class="mt-1 text-base font-medium text-brand">
                {job.url ? (
                  <a
                    href={job.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 hover:underline"
                  >
                    {job.company}
                    <Icon name="arrow-up-right" class="size-3.5" />
                  </a>
                ) : (
                  job.company
                )}
              </p>

              <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-fg-subtle">
                <span class="rounded-full bg-brand-soft px-2.5 py-0.5 font-medium text-brand">
                  {job.domain}
                </span>
                <span class="inline-flex items-center gap-1">
                  <Icon name="location" class="size-3.5" />
                  {job.location}
                </span>
              </div>

              <p class="mt-3 text-fg-muted">{job.summary}</p>

              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-fg-muted marker:text-fg-subtle">
                {job.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>

              <ul
                class="mt-4 flex flex-wrap gap-2"
                aria-label={`Technologies used at ${job.company}`}
              >
                {job.stack.map((tech) => (
                  <li class="rounded-md border border-border bg-bg-subtle px-2 py-0.5 text-xs font-medium text-fg-muted">
                    {tech}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ol>
</section>
