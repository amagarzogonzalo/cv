---
import { cv } from '../data/cv';

const { education, certifications, languages } = cv;
---

<section
  id="education"
  class="mx-auto max-w-4xl scroll-mt-20 px-5 py-10"
  aria-labelledby="education-heading"
>
  <h2 id="education-heading" class="text-2xl font-bold tracking-tight">
    Education &amp; credentials
  </h2>

  <div class="mt-6 grid gap-6 sm:grid-cols-2">
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">Education</h3>
      <ul class="mt-3 space-y-4">
        {
          education.map((edu) => (
            <li class="card rounded-2xl border border-border bg-surface p-5">
              <p class="font-semibold text-fg">{edu.degree}</p>
              <p class="mt-0.5 text-fg-muted">
                {edu.url ? (
                  <a
                    href={edu.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-brand hover:underline"
                  >
                    {edu.institution}
                  </a>
                ) : (
                  edu.institution
                )}
              </p>
              <p class="mt-1 text-sm text-fg-subtle">
                {edu.location && <>{edu.location} · </>}
                {edu.start}–{edu.end}
              </p>
              {edu.details && <p class="mt-2 text-sm text-fg-muted">{edu.details}</p>}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="space-y-6">
      {
        certifications.length > 0 && (
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">
              Certifications
            </h3>
            <ul class="mt-3 space-y-3">
              {certifications.map((cert) => (
                <li class="card rounded-2xl border border-border bg-surface p-5">
                  <p class="font-semibold text-fg">
                    {cert.url ? (
                      <a
                        href={cert.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-brand hover:underline"
                      >
                        {cert.name}
                      </a>
                    ) : (
                      cert.name
                    )}
                  </p>
                  <p class="mt-0.5 text-sm text-fg-subtle">
                    {cert.issuer} · {cert.date}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        languages.length > 0 && (
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">Languages</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {languages.map((lang) => (
                <li class="rounded-lg border border-border bg-bg-subtle px-3 py-1.5 text-sm text-fg-muted">
                  <span class="font-medium text-fg">{lang.name}</span>
                  <span class="text-fg-subtle"> · {lang.level}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>
