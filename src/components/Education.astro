---
import { cv } from '../data/cv';
import { formatRange } from '../lib/format';
import Icon from './Icon.astro';

const { education, certifications, languages } = cv;
---

<section
  id="education"
  class="mx-auto max-w-4xl scroll-mt-20 px-5 py-10"
  aria-labelledby="education-heading"
>
  <h2 id="education-heading" class="text-2xl font-bold tracking-tight">
    Education &amp; credentials
  </h2>

  <div class="mt-8 grid gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">Education</h3>
      <ol class="mt-4 space-y-5">
        {
          education.map((edu) => (
            <li class="card relative overflow-hidden rounded-2xl border border-border bg-surface p-6">
              <span class="absolute inset-y-0 left-0 w-1 bg-brand" aria-hidden="true" />
              <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
                <div class="flex items-start gap-3">
                  <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-brand-soft text-brand">
                    <Icon name="building" class="size-5" />
                  </span>
                  <div>
                    <h4 class="text-base font-semibold tracking-tight text-fg">{edu.degree}</h4>
                    <p class="mt-0.5 text-brand">
                      {edu.url ? (
                        <a
                          href={edu.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 hover:underline"
                        >
                          {edu.institution}
                          <Icon name="arrow-up-right" class="size-3.5" />
                        </a>
                      ) : (
                        edu.institution
                      )}
                    </p>
                  </div>
                </div>
                <p class="text-sm text-fg-subtle">{formatRange(edu.start, edu.end)}</p>
              </div>

              {(edu.awards?.length || edu.location) && (
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  {edu.awards?.map((award) => (
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-brand px-2.5 py-0.5 text-xs font-semibold text-brand-fg">
                      <Icon name="award" class="size-3.5" />
                      {award}
                    </span>
                  ))}
                  {edu.location && <span class="text-xs text-fg-subtle">{edu.location}</span>}
                </div>
              )}

              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-fg-muted marker:text-fg-subtle">
                {edu.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="space-y-6">
      {
        certifications.length > 0 && (
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">
              Certifications
            </h3>
            <ul class="mt-4 space-y-3">
              {certifications.map((cert) => (
                <li class="card rounded-2xl border border-border bg-surface p-5">
                  <p class="font-semibold text-fg">
                    {cert.url ? (
                      <a
                        href={cert.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-brand hover:underline"
                      >
                        {cert.name}
                      </a>
                    ) : (
                      cert.name
                    )}
                  </p>
                  <p class="mt-0.5 text-sm text-fg-subtle">
                    {cert.issuer} · {cert.date}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        languages.length > 0 && (
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">Languages</h3>
            <ul class="mt-4 space-y-3">
              {languages.map((lang) => (
                <li class="flex items-center justify-between gap-3 rounded-xl border border-border bg-surface px-4 py-3">
                  <span class="font-medium text-fg">{lang.name}</span>
                  <span class="text-sm text-fg-subtle">{lang.level}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>
