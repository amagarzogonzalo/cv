---
import { cv } from '../data/cv';
import { formatRange } from '../lib/format';
import Icon from './Icon.astro';
import Section from './Section.astro';

const { education, awards, certifications, languages } = cv;
const LEVELS = [1, 2, 3, 4, 5, 6];
---

<Section
  id="education"
  number="03"
  title="Education & credentials"
  meta={`${education.length} degrees`}
>
  <ol class="divide-y divide-border">
    {
      education.map((edu) => (
        <li class="grid grid-cols-1 gap-3 py-6 first:pt-0 last:pb-0 sm:grid-cols-[9.5rem_1fr] sm:gap-8">
          <div class="font-mono text-xs leading-relaxed text-fg-subtle">
            <span class="block tabular-nums">{formatRange(edu.start, edu.end)}</span>
            {edu.location && <span class="mt-1 block">{edu.location}</span>}
          </div>

          <div>
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h3 class="text-base font-semibold tracking-tight text-fg">{edu.degree}</h3>
              {edu.note && (
                <span class="font-mono text-[10px] uppercase tracking-wider text-fg-subtle">
                  {edu.note}
                </span>
              )}
              {edu.awards?.map((award) => (
                <span class="inline-flex items-center gap-1 rounded bg-brand-soft px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-brand">
                  <Icon name="award" class="size-3" />
                  {award}
                </span>
              ))}
            </div>

            <p class="mt-1 text-sm font-medium text-brand">
              {edu.url ? (
                <a
                  href={edu.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 hover:underline"
                >
                  {edu.institution}
                  <Icon name="arrow-up-right" class="size-3.5" />
                </a>
              ) : (
                edu.institution
              )}
            </p>

            <ul class="mt-3 list-disc space-y-1.5 pl-4 text-sm text-fg-muted marker:text-fg-subtle">
              {edu.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>

            {edu.links && edu.links.length > 0 && (
              <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
                {edu.links.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 font-mono text-[11px] text-brand hover:underline"
                  >
                    {link.label}
                    <Icon name="arrow-up-right" class="size-3.5" />
                  </a>
                ))}
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <div class="mt-10 grid grid-cols-1 gap-x-14 gap-y-10 border-t border-border pt-8 lg:grid-cols-2">
    <div>
      <h3 class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-fg-subtle">
        <Icon name="award" class="size-4 shrink-0 text-brand" />
        Distinctions &amp; honours
      </h3>
      <ul class="mt-4 space-y-3.5">
        {
          awards.map((award) => (
            <li class="flex gap-3">
              <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-3">
                  <p class="text-sm font-semibold text-fg">{award.title}</p>
                  {award.year && (
                    <span class="shrink-0 font-mono text-[11px] tabular-nums text-fg-subtle">
                      {award.year}
                    </span>
                  )}
                </div>
                <p class="mt-0.5 text-xs text-fg-muted">
                  {award.url ? (
                    <a
                      href={award.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 hover:text-brand hover:underline"
                    >
                      {award.detail}
                      <Icon name="arrow-up-right" class="size-3" />
                    </a>
                  ) : (
                    award.detail
                  )}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-wider text-fg-subtle">Languages</h3>
      <ul class="mt-4 space-y-4">
        {
          languages.map((lang) => (
            <li class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
              <div class="flex items-center justify-between gap-3 sm:contents">
                <span class="text-sm font-medium text-fg sm:w-24 sm:shrink-0">{lang.name}</span>
                <span class="font-mono text-[10px] leading-tight text-fg-subtle sm:order-3 sm:w-24 sm:shrink-0 sm:text-right sm:text-[11px]">
                  {lang.level}
                </span>
              </div>
              <span class="flex gap-1 sm:order-2 sm:min-w-0 sm:flex-1" aria-hidden="true">
                {LEVELS.map((step) => (
                  <span
                    class:list={[
                      'h-1.5 flex-1 rounded-full',
                      step <= (lang.score ?? 0) ? 'bg-brand' : 'bg-border',
                    ]}
                  />
                ))}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  {
    certifications.length > 0 && (
      <div class="mt-9 border-t border-border pt-5">
        <h3 class="font-mono text-[10px] uppercase tracking-wider text-fg-subtle">
          Certifications &amp; courses
        </h3>
        <ul class="mt-2.5 flex flex-wrap gap-x-6 gap-y-1.5">
          {certifications.map((cert) => (
            <li class="text-xs text-fg-subtle">
              {cert.url ? (
                <a
                  href={cert.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-fg-muted hover:text-fg hover:underline"
                >
                  {cert.name}
                </a>
              ) : (
                <span class="text-fg-muted">{cert.name}</span>
              )}
              <span class="font-mono text-[10px] text-fg-subtle">
                {' '}
                · {cert.issuer} · {cert.date}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</Section>
