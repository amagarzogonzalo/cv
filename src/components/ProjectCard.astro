---
import type { Project } from '../data/cv';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const slides = project.slides;
const num = String(index + 1).padStart(2, '0');
const slideTotal = String(slides.length).padStart(2, '0');
---

<article
  class="card overflow-hidden rounded-3xl border border-border bg-surface shadow-sm"
  aria-labelledby={`proj-${project.slug}-title`}
>
  <header
    class="flex flex-col gap-4 border-b border-border p-6 sm:flex-row sm:items-start sm:justify-between sm:p-7"
  >
    <div class="min-w-0">
      <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-brand">
        <span class="tabular-nums">{num}</span>
        <span class="h-px w-6 bg-brand/50" aria-hidden="true"></span>
        <span class="text-fg-subtle">{project.role}</span>
      </p>
      <h3
        id={`proj-${project.slug}-title`}
        class="mt-2 text-xl font-bold tracking-tight sm:text-2xl"
      >
        {project.name}
      </h3>
      <p class="mt-1 max-w-xl text-fg-muted">{project.tagline}</p>
    </div>

    <div class="flex shrink-0 items-center gap-2">
      {
        project.year && (
          <span class="rounded-full border border-border px-3 py-1 text-xs font-medium text-fg-subtle">
            {project.year}
          </span>
        )
      }
      {
        project.repo && (
          <a
            href={project.repo}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${project.name} source code (opens in a new tab)`}
            class="grid size-9 place-items-center rounded-full border border-border text-fg-muted transition hover:bg-bg-subtle hover:text-fg"
          >
            <Icon name="github" class="size-4" />
          </a>
        )
      }
      {
        project.url && (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${project.name} live site (opens in a new tab)`}
            class="grid size-9 place-items-center rounded-full border border-border text-fg-muted transition hover:bg-bg-subtle hover:text-fg"
          >
            <Icon name="external" class="size-4" />
          </a>
        )
      }
    </div>
  </header>

  <div
    class="proj-carousel relative"
    data-carousel
    role="group"
    aria-roledescription="carousel"
    aria-label={`${project.name} — project highlights`}
  >
    <div
      class="proj-track flex snap-x snap-mandatory overflow-x-auto scroll-smooth"
      data-track
      tabindex="0"
      aria-label={`${project.name} slides. Use the arrow keys to move between slides.`}
    >
      {
        slides.map((slide, i) => (
          <div
            class="proj-slide grid w-full shrink-0 snap-start md:grid-cols-2"
            data-slide
            role="group"
            aria-roledescription="slide"
            aria-label={`Slide ${i + 1} of ${slides.length}`}
          >
            <div class="proj-media relative aspect-[3/2] w-full overflow-hidden bg-bg-subtle md:aspect-auto md:h-full md:min-h-[22rem]">
              <img
                src={`/projects/${project.slug}/${i + 1}.webp`}
                alt=""
                width="1200"
                height="800"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 size-full object-cover"
              />
            </div>

            <div class="proj-body flex flex-col justify-center gap-3 p-6 sm:p-8">
              <p class="text-xs font-semibold uppercase tracking-widest text-brand">
                {slide.kicker}
              </p>
              <h4 class="text-lg font-semibold tracking-tight text-fg sm:text-xl">{slide.title}</h4>
              <p class="text-fg-muted">{slide.text}</p>
              {slide.stat && (
                <p class="mt-1 inline-flex w-fit items-center gap-2 rounded-full bg-brand-soft px-3 py-1 text-sm font-semibold text-brand">
                  {slide.stat}
                </p>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <div
      class="proj-controls flex items-center justify-between gap-4 border-t border-border px-6 py-4 sm:px-7"
    >
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-prev
          aria-label={`Previous slide in ${project.name}`}
          class="grid size-9 place-items-center rounded-full border border-border text-fg-muted transition hover:bg-bg-subtle hover:text-fg disabled:cursor-not-allowed disabled:opacity-40"
        >
          <Icon name="chevron-left" class="size-4" />
        </button>
        <button
          type="button"
          data-next
          aria-label={`Next slide in ${project.name}`}
          class="grid size-9 place-items-center rounded-full border border-border text-fg-muted transition hover:bg-bg-subtle hover:text-fg disabled:cursor-not-allowed disabled:opacity-40"
        >
          <Icon name="chevron-right" class="size-4" />
        </button>
      </div>

      <div class="flex items-center gap-2" role="group" aria-label={`${project.name} slides`}>
        {
          slides.map((_, i) => (
            <button
              type="button"
              data-dot
              aria-label={`Go to slide ${i + 1} of ${slides.length}`}
              aria-current={i === 0 ? 'true' : 'false'}
              class="dot h-1.5 w-6 rounded-full bg-border transition"
            />
          ))
        }
      </div>

      <p
        class="proj-count tabular-nums text-xs font-medium text-fg-subtle"
        data-count
        aria-hidden="true"
      >
        01 / {slideTotal}
      </p>
      <p class="sr-only" data-status aria-live="polite"></p>
    </div>
  </div>

  <footer class="flex flex-wrap gap-2 border-t border-border p-6 sm:p-7">
    {
      project.stack.map((tech) => (
        <span class="rounded-md bg-brand-soft px-2.5 py-1 text-xs font-medium text-brand">
          {tech}
        </span>
      ))
    }
  </footer>
</article>

<style>
  .proj-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .proj-track::-webkit-scrollbar {
    display: none;
  }

  .dot.is-active {
    background-color: var(--brand);
    width: 2rem;
  }
</style>

<script>
  const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;

    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-slide]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const status = root.querySelector<HTMLElement>('[data-status]');
    const count = root.querySelector<HTMLElement>('[data-count]');

    if (slides.length === 0) return;

    let index = 0;
    const pad = (n: number) => String(n + 1).padStart(2, '0');

    const render = () => {
      if (prev) prev.disabled = index <= 0;
      if (next) next.disabled = index >= slides.length - 1;
      dots.forEach((dot, i) => {
        dot.setAttribute('aria-current', i === index ? 'true' : 'false');
        dot.classList.toggle('is-active', i === index);
      });
      if (count) count.textContent = `${pad(index)} / ${pad(slides.length - 1)}`;
      if (status) status.textContent = `Slide ${index + 1} of ${slides.length}`;
    };

    const goTo = (i: number) => {
      index = Math.max(0, Math.min(slides.length - 1, i));
      const left = slides[index].offsetLeft - slides[0].offsetLeft;
      track.scrollTo({ left, behavior: prefersReducedMotion() ? 'auto' : 'smooth' });
      render();
    };

    prev?.addEventListener('click', () => goTo(index - 1));
    next?.addEventListener('click', () => goTo(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(index + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(index - 1);
      }
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const i = slides.indexOf(entry.target as HTMLElement);
            if (i !== -1 && i !== index) {
              index = i;
              render();
            }
          });
        },
        { root: track, threshold: 0.55 },
      );
      slides.forEach((slide) => observer.observe(slide));
    }

    render();
  });
</script>
