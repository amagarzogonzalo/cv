---
import { cv } from '../data/cv';
import Section from './Section.astro';
import ProjectShowcase from './ProjectShowcase.astro';

const projects = cv.projects;
---

<Section id="work" number="01" title="Selected work" meta={`${projects.length} projects`}>
  <p class="mb-6 max-w-2xl text-sm text-fg-muted">
    Production AI systems, from problem framing to deployment. Use the arrows, the names below, or
    swipe to move through projects.
  </p>
  <ProjectShowcase />
</Section>
