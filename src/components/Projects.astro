---
import { cv } from '../data/cv';
import Icon from './Icon.astro';

const { projects } = cv;
---

<section
  id="projects"
  class="mx-auto max-w-4xl scroll-mt-20 px-5 py-10"
  aria-labelledby="projects-heading"
>
  <h2 id="projects-heading" class="text-2xl font-bold tracking-tight">Selected projects</h2>

  <div class="mt-6 grid gap-5 sm:grid-cols-2">
    {
      projects.map((project) => (
        <article class="card flex flex-col rounded-2xl border border-border bg-surface p-5">
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-lg font-semibold text-fg">{project.name}</h3>
            <div class="no-print flex items-center gap-2">
              {project.repo && (
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${project.name} source code`}
                  class="text-fg-subtle hover:text-fg"
                >
                  <Icon name="github" class="size-5" />
                </a>
              )}
              {project.url && (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${project.name} live site`}
                  class="text-fg-subtle hover:text-fg"
                >
                  <Icon name="external" class="size-5" />
                </a>
              )}
            </div>
          </div>

          <p class="mt-2 text-fg-muted">{project.description}</p>

          {project.highlights && project.highlights.length > 0 && (
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-fg-muted marker:text-fg-subtle">
              {project.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}

          <ul class="mt-4 flex flex-wrap gap-2 pt-0" aria-label="Technologies">
            {project.stack.map((tech) => (
              <li class="rounded-md bg-brand-soft px-2 py-0.5 text-xs font-medium text-brand">
                {tech}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
