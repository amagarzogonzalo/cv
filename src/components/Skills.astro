---
import { cv } from '../data/cv';
import Icon from './Icon.astro';
import Section from './Section.astro';

const { skills } = cv;
---

<Section id="skills" number="03" title="Skills" meta={`${skills.length} areas`}>
  <div class="grid gap-x-12 gap-y-7 sm:grid-cols-2">
    {
      skills.map((group) => (
        <div>
          <h3 class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-fg-subtle">
            <Icon name={group.icon} class="size-4 shrink-0 text-brand" />
            {group.category}
          </h3>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <li class="rounded border border-border px-2 py-1 text-xs text-fg-muted">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
