---
import { cv } from '../data/cv';
import Icon from './Icon.astro';

const { skills } = cv;
---

<section
  id="skills"
  class="mx-auto max-w-4xl scroll-mt-20 px-5 py-10"
  aria-labelledby="skills-heading"
>
  <h2 id="skills-heading" class="text-2xl font-bold tracking-tight">Skills</h2>
  <p class="mt-2 max-w-xl text-fg-muted">
    Grouped by what I actually work with, from models to deployment.
  </p>

  <div class="mt-8 grid gap-5 sm:grid-cols-2">
    {
      skills.map((group) => (
        <div class="card group rounded-2xl border border-border bg-surface p-6 transition hover:border-brand/40">
          <div class="flex items-center gap-3">
            <span class="grid size-10 place-items-center rounded-xl bg-brand-soft text-brand">
              <Icon name={group.icon} class="size-5" />
            </span>
            <h3 class="text-base font-semibold tracking-tight text-fg">{group.category}</h3>
          </div>
          <ul class="mt-4 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-lg border border-border bg-bg-subtle px-2.5 py-1 text-sm text-fg-muted">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
