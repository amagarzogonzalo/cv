---
import { cv } from '../data/cv';

const { skills } = cv;
---

<section
  id="skills"
  class="mx-auto max-w-4xl scroll-mt-20 px-5 py-10"
  aria-labelledby="skills-heading"
>
  <h2 id="skills-heading" class="text-2xl font-bold tracking-tight">Skills</h2>

  <div class="mt-6 grid gap-6 sm:grid-cols-2">
    {
      skills.map((group) => (
        <div class="card rounded-2xl border border-border bg-surface p-5">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">
            {group.category}
          </h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-lg border border-border bg-bg-subtle px-2.5 py-1 text-sm text-fg-muted">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
