---
import { cv } from '../data/cv';
import Icon from './Icon.astro';

const { personal, links, summary } = cv;
const primaryLinks = links.filter((l) => l.icon !== 'email');
---

<section class="mx-auto max-w-4xl px-5 pt-14 pb-4 sm:pt-20" aria-labelledby="intro-heading">
  <p class="mb-3 flex items-center gap-2 text-sm font-medium text-brand">
    <span class="inline-block size-2 rounded-full bg-brand" aria-hidden="true"></span>
    {personal.availability ?? personal.role}
  </p>

  <h1 id="intro-heading" class="text-4xl font-bold tracking-tight text-fg sm:text-5xl">
    {personal.name}
  </h1>

  <p class="mt-3 text-xl font-semibold text-fg-muted sm:text-2xl">{personal.role}</p>

  <p class="mt-4 max-w-2xl text-lg text-fg-muted">{personal.tagline}</p>

  <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-fg-subtle">
    <span class="inline-flex items-center gap-1.5">
      <Icon name="location" class="size-4" />
      {personal.location}
    </span>
    {personal.remote && <span aria-hidden="true">·</span>}
    {personal.remote && <span>Open to remote</span>}
  </p>

  <div class="no-print mt-7 flex flex-wrap items-center gap-3">
    <button
      type="button"
      id="download-pdf"
      class="inline-flex items-center gap-2 rounded-xl bg-brand px-4 py-2.5 text-sm font-semibold text-brand-fg shadow-sm transition hover:opacity-90"
    >
      <Icon name="download" class="size-4" />
      Download PDF
    </button>

    <a
      href={`mailto:${personal.email}`}
      class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface px-4 py-2.5 text-sm font-semibold text-fg transition hover:bg-bg-subtle"
    >
      <Icon name="email" class="size-4" />
      Email
    </a>

    {
      primaryLinks.map((link) => (
        <a
          href={link.url}
          target={link.url.startsWith('http') ? '_blank' : undefined}
          rel={link.url.startsWith('http') ? 'me noopener noreferrer' : undefined}
          class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface px-4 py-2.5 text-sm font-semibold text-fg transition hover:bg-bg-subtle"
        >
          <Icon name={link.icon} class="size-4" />
          {link.label}
        </a>
      ))
    }
  </div>

  <div class="mt-10 space-y-3 text-base leading-relaxed text-fg-muted">
    {summary.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>

<script>
  document.getElementById('download-pdf')?.addEventListener('click', () => window.print());
</script>
