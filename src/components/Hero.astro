---
import { cv } from '../data/cv';
import Icon from './Icon.astro';

const { personal, links, summary } = cv;
const primaryLinks = links.filter((l) => l.icon !== 'email' && l.icon !== 'website');
---

<section class="mx-auto max-w-5xl px-5 pt-14 pb-2 sm:pt-20">
  <div class="flex items-start justify-between gap-6 sm:gap-10">
    <div class="min-w-0 flex-1">
      <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-brand">
        <span class="relative flex size-2" aria-hidden="true">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-brand opacity-75"
          ></span>
          <span class="relative inline-flex size-2 rounded-full bg-brand"></span>
        </span>
        {personal.availability ?? personal.role}
      </p>

      <h1 class="mt-4 text-4xl font-bold tracking-tight text-fg sm:text-5xl">
        {personal.name}
      </h1>

      <p class="mt-2 text-lg font-medium text-fg-muted sm:text-xl">{personal.role}</p>

      <p class="mt-4 max-w-2xl text-lg text-fg-muted">{personal.tagline}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-fg-subtle">
        <span class="inline-flex items-center gap-1.5 font-mono text-xs">
          <Icon name="location" class="size-4" />
          {personal.location}
        </span>
        {personal.remote && <span class="font-mono text-xs">Open to remote</span>}
        {
          personal.phone && (
            <a
              href={`tel:${personal.phone.replace(/\s+/g, '')}`}
              class="inline-flex items-center gap-1.5 font-mono text-xs transition hover:text-fg"
            >
              <Icon name="phone" class="size-4" />
              {personal.phone}
            </a>
          )
        }
      </div>
    </div>

    {
      personal.photo && (
        <div class="no-print relative shrink-0">
          <span
            class="absolute inset-0 translate-x-1.5 translate-y-1.5 rounded-2xl bg-brand/20 sm:translate-x-2 sm:translate-y-2 sm:rounded-3xl"
            aria-hidden="true"
          />
          <img
            src={personal.photo}
            alt={`Portrait of ${personal.name}`}
            width="360"
            height="360"
            loading="eager"
            decoding="async"
            class="relative size-24 rounded-2xl border border-border object-cover shadow-sm sm:size-36 sm:rounded-3xl lg:size-44"
          />
          <span
            class="absolute -right-1 -bottom-1 grid size-5 place-items-center rounded-full bg-bg sm:-right-1.5 sm:-bottom-1.5 sm:size-6"
            aria-hidden="true"
          >
            <span class="size-2.5 rounded-full bg-emerald-500 sm:size-3" />
          </span>
        </div>
      )
    }
  </div>

  <div class="no-print mt-7 flex flex-wrap items-center gap-2.5">
    <button
      type="button"
      id="download-pdf"
      class="inline-flex items-center gap-2 rounded-xl bg-brand px-4 py-2.5 text-sm font-semibold text-brand-fg shadow-sm transition hover:opacity-90"
    >
      <Icon name="download" class="size-4" />
      Download PDF
    </button>

    <a
      href={`mailto:${personal.email}`}
      class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface px-4 py-2.5 text-sm font-semibold text-fg transition hover:bg-bg-subtle"
    >
      <Icon name="email" class="size-4" />
      Email
    </a>

    {
      primaryLinks.map((link) => (
        <a
          href={link.url}
          target={link.url.startsWith('http') ? '_blank' : undefined}
          rel={link.url.startsWith('http') ? 'me noopener noreferrer' : undefined}
          class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface px-4 py-2.5 text-sm font-semibold text-fg transition hover:bg-bg-subtle"
        >
          <Icon name={link.icon} class="size-4" />
          {link.label}
        </a>
      ))
    }
  </div>

  <div class="mt-8 max-w-2xl space-y-2 text-sm leading-relaxed text-fg-muted">
    {summary.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Focus areas">
    {
      personal.focus.map((item) => (
        <li class="rounded border border-border px-2 py-1 font-mono text-[11px] text-fg-subtle">
          {item}
        </li>
      ))
    }
  </ul>
</section>

<script>
  document.getElementById('download-pdf')?.addEventListener('click', () => window.print());
</script>
