---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — {cv.meta.title}"
  description="The page you are looking for does not exist."
  path="/404"
  noindex={true}
>
  <section class="mx-auto flex max-w-4xl flex-col items-start px-5 py-28">
    <p class="text-sm font-semibold text-brand">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-4 text-fg-muted">The page you were looking for has moved or never existed.</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-xl bg-brand px-4 py-2.5 text-sm font-semibold text-brand-fg hover:opacity-90"
    >
      Back to the CV
    </a>
  </section>
</BaseLayout>
